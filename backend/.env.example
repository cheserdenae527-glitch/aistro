APP_NAME=AiRestro API
APP_VERSION=0.1.0
DEBUG=false
DATABASE_URL=postgresql+asyncpg://aistro:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/aistro
SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY
CORS_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=aistro

# 本地文件存储（不装 Docker 后替代 MinIO；Docker/MinIO 仅用于旧数据迁移）
LOCAL_STORAGE_DIR=D:/two/data/storage
# 媒体 URL 前缀（后端自身地址）
PUBLIC_BASE_URL=http://127.0.0.1:8000
VOLCENGINE_API_KEY=CHANGE_ME_VOLCENGINE_API_KEY
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_IMAGE_MODEL=doubao-seedream-5-0-260128
VOLCENGINE_VISION_MODEL=doubao-seed-2-1-pro-260628
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 高德地图 MCP ---
# 高德开放平台 Web 服务 Key（https://lbs.amap.com/ 申请）
AMAP_MAPS_API_KEY=CHANGE_ME_AMAP_MAPS_API_KEY
# MCP 地址：留空默认 https://mcp.amap.com/mcp ；或用 ModelScope MCP 广场生成的 SSE 地址
AMAP_MCP_URL=
# 可选：ModelScope 代理需要的鉴权 Token（如 MODELSCOPE_API_KEY）
AMAP_MCP_AUTH_TOKEN=

AMAP_WEB_API_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_DAILY_QUOTA_LIMIT=8000


# --- 站大爷隧道代理（小红书爬虫） ---
# 控制台：实例管理 > 隧道代理 > 管理 > 控制面板，查看隧道域名、HTTP 端口、用户名、密码
# period: 15~1800 秒；region 示例: area-EC / prov-33-city-330100；pool: enh / std
XHS_TUNNEL_USERNAME=
XHS_TUNNEL_PASSWORD=
XHS_TUNNEL_HOST=
XHS_TUNNEL_HTTP_PORT=8080
# 备用入口（可选）：主入口不可用时仍可继续请求；配置后会和主入口一起进入代理池轮换
XHS_TUNNEL_BACKUP_HOST=
XHS_TUNNEL_BACKUP_HTTP_PORT=8080
XHS_TUNNEL_PERIOD=60
XHS_TUNNEL_POOL=enh
XHS_TUNNEL_REGION=
XHS_TUNNEL_SID=

# 隧道多通道：在站大爷控制台给隧道实例添加多条通道后，把 sid 用逗号分隔填到这里。
# 每个 sid 对应一个独立隧道入口/出口 IP 池，爬虫会按多 IP 池轮换。
# 示例：XHS_TUNNEL_SIDS=aa0001,ab0002,ac0003
XHS_TUNNEL_SIDS=

# --- 站大爷短效代理（可选，与隧道二选一；优先级：隧道多通道 > 短效代理 > crawler_config.json 静态列表） ---
# 方式一：直接把控制台生成的完整 JSON 提取链接贴到 XHS_SHORT_PROXY_API（已含 api/akey 时无需填下面两项）
# 方式二：填基础地址 + 实例 ID + akey（akey 为密码的 16 位小写 MD5；也可直接填 XHS_SHORT_PROXY_PASSWORD）
# count 单次提取数量；timespan 3 表示 3-6 分钟短效 IP；刷新间隔建议 60-120 秒
XHS_SHORT_PROXY_API=http://www.zdopen.com/ShortProxy/GetIP/
XHS_SHORT_PROXY_API_ID=
XHS_SHORT_PROXY_AKEY=
XHS_SHORT_PROXY_PASSWORD=
XHS_SHORT_PROXY_COUNT=5
XHS_SHORT_PROXY_TIMESPAN=3
XHS_SHORT_PROXY_REFRESH_SECONDS=90

# --- Cookie 池轮换策略（小规模自用推荐值） ---
# 单个 Cookie 1 小时内最多使用次数；连续失败几次进入冷却；冷却时长（秒）；总失败几次淘汰
XHS_COOKIE_MAX_USE_PER_HOUR=25
XHS_COOKIE_MAX_CONTINUOUS_FAIL=2
XHS_COOKIE_COOLING_SECONDS=1800
XHS_COOKIE_MAX_TOTAL_FAIL=8
# Cookie 粘性代理 session 时长（秒）；session 到期后重新分配代理
XHS_COOKIE_PROXY_SESSION_SECONDS=300
# 同一代理连续失败几次后解绑，下次取号时换新代理
XHS_COOKIE_MAX_PROXY_FAILURES=2

# --- JustOneAPI（小红书蒲公英平台历史涨粉数据） ---
# Token 在 https://justoneapi.com 控制台获取；留空时分析自动回退本地订阅快照
JUST_ONE_API_TOKEN=
JUST_ONE_API_BASE_URL=https://api.justoneapi.com
JUST_ONE_API_TIMEOUT_SECONDS=60
