APP_NAME=AiRestro API
APP_VERSION=0.1.0
DEBUG=false
DATABASE_URL=postgresql+asyncpg://aistro:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5433/aistro
SECRET_KEY=CHANGE_ME_STRONG_SECRET_KEY
CORS_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=aistro
VOLCENGINE_API_KEY=CHANGE_ME_VOLCENGINE_API_KEY
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_IMAGE_MODEL=doubao-seedream-5-0-260128
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 高德地图 MCP ---
# 高德开放平台 Web 服务 Key（https://lbs.amap.com/ 申请）
AMAP_MAPS_API_KEY=CHANGE_ME_AMAP_MAPS_API_KEY
# MCP 地址：留空默认 https://mcp.amap.com/mcp ；或用 ModelScope MCP 广场生成的 SSE 地址
AMAP_MCP_URL=
# 可选：ModelScope 代理需要的鉴权 Token（如 MODELSCOPE_API_KEY）
AMAP_MCP_AUTH_TOKEN=

AMAP_WEB_API_KEY=
AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_DAILY_QUOTA_LIMIT=8000
