{
  "manifest_version": 3,
  "name": "AiRestro XHS Bridge",
  "version": "0.1.1",
  "description": "真实会话采集小红书笔记并直连本地 AiRestro 后端（自建实现，学习 Beav 机制）",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://www.rednote.com/*",
    "https://edith.xiaohongshu.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*", "https://www.rednote.com/*"],
      "js": ["src/xhsBridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.xiaohongshu.com/*", "https://www.rednote.com/*"],
      "js": ["src/captureRuntime.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "AiRestro XHS Bridge"
  }
}
